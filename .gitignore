# Keep the source distribution explicit; local experiments remain on disk.
# Only the current project README is published.
/*.md
!/README.md
/*.txt
/.local-tools/
/artifacts/
/.kernel-build-*/
/.kernel-kbuild-overlay*/
/vtdbg
/anti_debug_tracee
/ida_combo_tracee
/nested_mt_tracee
/*.bin
/; done

# Current framework source only.
/src/*
!/src/linux_server_shim.c
!/src/ida90_event_adapter.inc
!/src/parent_resume_semantics.inc
!/src/owner_wait_view.inc
!/src/wait_entry_x86_64.S
/include/*
!/include/joint_debug_abi.h
!/include/shared_event_reader.h
/driver/*
!/driver/Makefile
!/driver/joint_policy.c
!/driver/owner_wait_context.inc
!/driver/stopped_debugregs.inc

# Public launchers/adapters; keep personal launchers untracked.
/tools/*
!/tools/ida_joint_client.py
!/tools/ida_joint_plugin.py
!/tools/start_joint_server.sh
!/tools/build_kernel_module.sh
!/tools/build_kernel_overlay.sh
!/tools/export_kernel_headers.sh

# Source-generated fixtures and reusable tests, not target-specific scripts.
/tests/*
!/tests/policy_*.c
!/tests/shared_ring_reader_smoke.c
!/tests/kernel_tree_ptrace_smoke.c
!/tests/server_ptrace_harness.c
!/tests/anti_debug_tracee.c
!/tests/parent_owned_call_tracee.c
!/tests/parent_owned_exception_tracee.c
!/tests/nested_mt_tracee.c
!/tests/test_joint_shim.py
!/tests/ida_joint_fixture.py
!/tests/run_joint_fixture.py
!/tests/run_kernel_smokes.sh

